<Window x:Class="WindowsAirplay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows AirPlay" Width="620" Height="760" MinWidth="510" MinHeight="600" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28">
  <TextBlock Text="Windows AirPlay" FontSize="28" FontWeight="SemiBold"/>
  <TextBlock Text="A second screen for your Mac." Foreground="#526176" Margin="0,5,0,22"/>
  <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#DFE5ED" BorderThickness="1">
   <StackPanel>
    <Label Content="Receiver _name" Target="{Binding ElementName=ReceiverNameBox}" Padding="0,0,0,6"/>
    <TextBox x:Name="ReceiverNameBox" Text="{Binding ReceiverName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Receiver name" MaxLength="50"/>
    <Label Content="_Display on Windows" Target="{Binding ElementName=MonitorBox}" Padding="0,18,0,6"/>
    <ComboBox x:Name="MonitorBox" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Windows monitor">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="#526176" Text="{Binding Bounds}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Requested: 1920 × 1080 at 60 Hz · Audio off" Foreground="#526176" FontSize="12" Margin="0,12,0,0"/>
    <TextBlock Text="Delivered resolution and frame rate have not been measured." Foreground="#526176" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
     <Button Content="_Start receiving" Command="{Binding StartCommand}" Background="#2162D6" Foreground="White" BorderBrush="#2162D6" FontWeight="SemiBold"/>
     <Button Content="S_top" Command="{Binding StopCommand}"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border Background="#E8EEF7" CornerRadius="8" Padding="16" Margin="0,16,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Border Background="#E5F4EB" BorderBrush="#95CBA8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0" Visibility="{Binding HasPairingCode,Converter={StaticResource BooleanToVisibility}}">
   <StackPanel><TextBlock Text="Enter this password on your Mac"/><TextBlock Text="{Binding PairingCode}" FontSize="32" FontWeight="SemiBold" AutomationProperties.Name="AirPlay pairing password"/></StackPanel>
  </Border>
  <TextBlock Text="Connect from your Mac" FontWeight="SemiBold" Margin="0,22,0,6"/>
  <TextBlock Text="Open Control Center → Screen Mirroring and select the receiver name above. Enter the displayed password, then choose Extended Display." TextWrapping="Wrap" Foreground="#526176"/>
  <TextBlock Text="While receiving, closing this window keeps AirPlay running. Use the tray icon to Open, Stop, or Exit." TextWrapping="Wrap" Foreground="#526176" FontSize="12" Margin="0,10,0,0"/>
  <Expander Header="Diagnostics" Margin="0,16,0,0"><TextBox Text="{Binding Diagnostics,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Receiver diagnostics"/></Expander>
  <Button Content="E_xit app" HorizontalAlignment="Right" Click="ExitClicked" Margin="0,12,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>